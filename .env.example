# ==========================================
# RAG System Configuration (.env.example)
# ==========================================

# 1. Vector Database Engine ('postgres' or 'file')
VECTOR_STORE_BACKEND=postgres

# 2. Local PostgreSQL Connection Settings & Pool Sizing
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rag_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_MIN_POOL=1
POSTGRES_MAX_POOL=10

# 3. LLM Generation Settings (Groq)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# 4. Sentence Transformer Embedding Model
EMBEDDING_MODEL=all-MiniLM-L6-v2
